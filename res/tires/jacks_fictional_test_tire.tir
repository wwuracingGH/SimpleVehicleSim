[MDI_HEADER]
FILE_TYPE                ='tir'
FILE_VERSION             = 3.0
FILE_FORMAT              ='ASCII'
$-----------------------------------------------------------------units
[UNITS]
LENGTH                   ='meter'
FORCE                    ='newton'
ANGLE                    ='radians'
MASS                     ='kg'
TIME                     ='second'
$-----------------------------------------------------------------model
[MODEL]
FITTYP                   = 61                $Magic Formula Version number
TYRESIDE                 ='LEFT'             $Position of tire during measurements
LONGVL                   = 11.176            $Reference speed (25 mph)
VXLOW                    = 1                 $Lower boundary of slip calculation
ROAD_INCREMENT           = 0.01              $Increment in road sampling
ROAD_DIRECTION           = 1                 $Direction of travelled distance
PROPERTY_FILE_FORMAT     ='USER'
USER_SUB_ID              = 815
N_TIRE_STATES            = 5
USE_MODE                 = 4                 $Tyre use mode switch (ADAMS only)
HMAX_LOCAL               = 2.5E-4            $Local integration time step (ADAMS only)
TIME_SWITCH_INTEG        = 0.1               $Time when local integrator is activated (ADAMS only)
$------------------------------------------------------------dimensions
[DIMENSION]
UNLOADED_RADIUS          = 0.2286            $Free tyre radius (9.0 in)
WIDTH                    = 0.1778            $Nominal section width of the tyre
RIM_RADIUS               = 0.127             $Nominal rim radius (10 in wheel)
RIM_WIDTH                = 0.1778            $Rim width (7 in)
ASPECT_RATIO             = 0.571             $Nominal aspect ratio
$-------------------------------------------------operating conditions
[OPERATING_CONDITIONS]
INFLPRES                 = 83000             $Tyre inflation pressure (12 psi)
NOMPRES                  = 83000             $Nominal pressure used in MF equations
$---------------------------------------------------------------inertia
[INERTIA]
MASS                     = 3.6               $Tyre Mass
IXX                      = 0.068             $Tyre diametral moment of inertia
IYY                      = 0.118             $Tyre polar moment of inertia
BELT_MASS                = 2.4               $Belt mass
BELT_IXX                 = 0.052             $Belt diametral moment of inertia
BELT_IYY                 = 0.094             $Belt polar moment of inertia
GRAVITY                  = -9.81             $Gravity acting on belt in Z direction
$--------------------------------------------------------------vertical
[VERTICAL]
FNOMIN                   = 1100              $Nominal wheel load
VERTICAL_STIFFNESS       = 110000            $Tyre vertical stiffness
VERTICAL_DAMPING         = 60                $Tyre vertical damping
MC_CONTOUR_A             = 0                 $Motorcycle contour ellips A
MC_CONTOUR_B             = 0                 $Motorcycle contour ellips B
BREFF                    = 8.4               $Low load stiffness effective rolling radius
DREFF                    = 0.27              $Peak value of effective rolling radius
FREFF                    = 0.07              $High load stiffness effective rolling radius
Q_RE0                    = 0.998             $Ratio of free tyre radius with nominal tyre radius
Q_V1                     = 0.0005            $Tyre radius increase with speed
Q_V2                     = 0.03              $Vertical stiffness increase with speed
Q_FZ2                    = 12                $Quadratic term in load vs. deflection
Q_FCX                    = 0.1               $Longitudinal force influence on vertical stiffness
Q_FCY                    = 0.15              $Lateral force influence on vertical stiffness
Q_CAM                    = 0                 $Stiffness reduction due to camber
PFZ1                     = 0.65              $Pressure effect on vertical stiffness
BOTTOM_OFFST             = 0.01              $Distance to rim when bottoming starts to occur
BOTTOM_STIFF             = 1100000           $Vertical stiffness of bottomed tyre
$-------------------------------------------------------------structural
[STRUCTURAL]
LONGITUDINAL_STIFFNESS   = 160000            $Tyre overall longitudinal stiffness
LATERAL_STIFFNESS        = 75000             $Tyre overall lateral stiffness
YAW_STIFFNESS            = 2200              $Tyre overall yaw stiffness
FREQ_LONG                = 95                $Undamped frequency fore/aft and vertical mode
FREQ_LAT                 = 55                $Undamped frequency lateral mode
FREQ_YAW                 = 70                $Undamped frequency yaw and camber mode
FREQ_WINDUP              = 80                $Undamped frequency wind-up mode
DAMP_LONG                = 0.05              $Dimensionless damping fore/aft and vertical mode
DAMP_LAT                 = 0.05              $Dimensionless damping lateral mode
DAMP_YAW                 = 0.05              $Dimensionless damping yaw and camber mode
DAMP_WINDUP              = 0.05              $Dimensionless damping wind-up mode
DAMP_RESIDUAL            = 0.002             $Residual damping (proportional to stiffness)
DAMP_VLOW                = 0.001             $Additional low speed damping (proportional to stiffness)
Q_BVX                    = 0                 $Load and speed influence on in-plane translation stiffness
Q_BVT                    = 0                 $Load and speed influence on in-plane rotation stiffness
PCFX1                    = 0                 $Tyre overall longitudinal stiffness vertical deflection dependency linear term
PCFX2                    = 0                 $Tyre overall longitudinal stiffness vertical deflection dependency quadratic term
PCFX3                    = 0                 $Tyre overall longitudinal stiffness pressure dependency
PCFY1                    = 0                 $Tyre overall lateral stiffness vertical deflection dependency linear term
PCFY2                    = 0                 $Tyre overall lateral stiffness vertical deflection dependency quadratic term
PCFY3                    = 0                 $Tyre overall lateral stiffness pressure dependency
PCMZ1                    = 0                 $Tyre overall yaw stiffness pressure dependency
$--------------------------------------------------------contact_patch
[CONTACT_PATCH]
Q_RA1                    = 0.55              $Square root term in contact length equation
Q_RA2                    = 1.0               $Linear term in contact length equation
Q_RB1                    = 1.05              $Root term in contact width equation
Q_RB2                    = -0.8              $Linear term in contact width equation
ELLIPS_SHIFT             = 0.8               $Scaling of distance between front and rear ellipsoid
ELLIPS_LENGTH            = 1                 $Semimajor axis of ellipsoid
ELLIPS_HEIGHT            = 1                 $Semiminor axis of ellipsoid
ELLIPS_ORDER             = 1.8               $Order of ellipsoid
ELLIPS_MAX_STEP          = 0.025             $Maximum height of road step
ELLIPS_NWIDTH            = 10                $Number of parallel ellipsoids
ELLIPS_NLENGTH           = 10                $Number of ellipsoids at sides of contact patch
$---------------------------------------------inflation_pressure_range
[INFLATION_PRESSURE_RANGE]
PRESMIN                  = 55000             $Minimum allowed inflation pressure (8 psi)
PRESMAX                  = 110000            $Maximum allowed inflation pressure (16 psi)
$-------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN                    = 100               $Minimum allowed wheel load
FZMAX                    = 2000              $Maximum allowed wheel load
$------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN                   = -0.25             $Minimum valid wheel slip
KPUMAX                   = 0.25              $Maximum valid wheel slip
$-----------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN                   = -0.2618           $Minimum valid slip angle (-15 deg)
ALPMAX                   = 0.2618            $Maximum valid slip angle (+15 deg)
$-----------------------------------------------inclination_angle_range
[INCLINATION_ANGLE_RANGE]
CAMMIN                   = -0.0698           $Minimum valid camber angle (-4 deg)
CAMMAX                   = 0.0698            $Maximum valid camber angle (+4 deg)
$--------------------------------------------------scaling_coefficients
[SCALING_COEFFICIENTS]
LFZO                     = 1                 $Scale factor of nominal (rated) load
LCX                      = 1                 $Scale factor of Fx shape factor
LMUX                     = 1                 $Scale factor of Fx peak friction coefficient
LEX                      = 1                 $Scale factor of Fx curvature factor
LKX                      = 1                 $Scale factor of Fx slip stiffness
LHX                      = 1                 $Scale factor of Fx horizontal shift
LVX                      = 1                 $Scale factor of Fx vertical shift
LCY                      = 1                 $Scale factor of Fy shape factor
LMUY                     = 1                 $Scale factor of Fy peak friction coefficient
LEY                      = 1                 $Scale factor of Fy curvature factor
LKY                      = 1                 $Scale factor of Fy cornering stiffness
LKYC                     = 1                 $Scale factor of Fy camber stiffness
LKZC                     = 1                 $Scale factor of Mz camber stiffness
LHY                      = 1                 $Scale factor of Fy horizontal shift
LVY                      = 1                 $Scale factor of Fy vertical shift
LTR                      = 1                 $Scale factor of Peak of pneumatic trail
LRES                     = 1                 $Scale factor for offset of Mz residual torque
LXAL                     = 1                 $Scale factor of alpha influence on Fx
LYKA                     = 1                 $Scale factor of kappa influence on Fy
LVYKA                    = 1                 $Scale factor of kappa induced Fy
LS                       = 1                 $Scale factor of Moment arm of Fx
LMX                      = 1                 $Scale factor of overturning moment
LVMX                     = 1                 $Scale factor of Mx vertical shift
LMY                      = 1                 $Scale factor of rolling resistance torque
LMP                      = 1                 $Scale factor of Parking moment
$---------------------------------------------longitudinal_coefficients
[LONGITUDINAL_COEFFICIENTS]
PCX1                     = 1.55              $Shape factor Cfx for longitudinal force
PDX1                     = 2.55              $Longitudinal friction Mux at Fznom
PDX2                     = -0.25             $Variation of friction Mux with load
PDX3                     = 2.0               $Variation of friction Mux with camber squared
PEX1                     = -0.20             $Longitudinal curvature Efx at Fznom
PEX2                     = 0.15             $Variation of curvature Efx with load
PEX3                     = 0.0               $Variation of curvature Efx with load squared
PEX4                     = 0.08              $Factor in curvature Efx while driving
PKX1                     = 40.0              $Longitudinal slip stiffness Kfx./Fz at Fznom
PKX2                     = -5.0              $Variation of slip stiffness Kfx./Fz with load
PKX3                     = -0.3              $Exponent in slip stiffness Kfx./Fz with load
PHX1                     = 0.0005            $Horizontal shift Shx at Fznom
PHX2                     = 0.0002            $Variation of shift Shx with load
PVX1                     = 0.0               $Vertical shift Svx/Fz at Fznom
PVX2                     = 0.0               $Variation of shift Svx/Fz with load
PPX1                     = -0.30             $linear influence of inflation pressure on longitudinal slip stiffness
PPX2                     = 0.10              $quadratic influence of inflation pressure on longitudinal slip stiffness
PPX3                     = -0.05             $linear influence of inflation pressure on peak longitudinal friction
PPX4                     = -0.40             $quadratic influence of inflation pressure on peak longitudinal friction
RBX1                     = 12.0              $Slope factor for combined slip Fx reduction
RBX2                     = 10.0              $Variation of slope Fx reduction with kappa
RBX3                     = 0.0               $Influence of camber on stiffness for Fx combined
RCX1                     = 1.05              $Shape factor for combined slip Fx reduction
REX1                     = 0.0               $Curvature factor of combined Fx
REX2                     = 0.0               $Curvature factor of combined Fx with load
RHX1                     = 0.0               $Shift factor for combined slip Fx reduction
$----------------------------------------------overturning_coefficients
[OVERTURNING_COEFFICIENTS]
QSX1                     = 0.0               $Vertical shift of overturning moment
QSX2                     = 0.8               $Camber induced overturning couple
QSX3                     = 0.05              $Fy induced overturning couple
QSX4                     = 0.0               $Mixed load lateral force and camber on Mx
QSX5                     = 0.0               $Load effect on Mx with lateral force and camber
QSX6                     = 0.0               $B-factor of load with Mx
QSX7                     = 0.0               $Camber with load on Mx
QSX8                     = 0.0               $Lateral force with load on Mx
QSX9                     = 0.0               $B-factor of lateral force with load on Mx
QSX10                    = 0.0               $Vertical force with camber on Mx
QSX11                    = 0.0               $B-factor of vertical force with camber on Mx
QSX12                    = 0.0               $Camber squared induced overturning moment
QSX13                    = 0.0               $Lateral force induced overturning moment
QSX14                    = 0.0               $Lateral force induced overturning moment with camber
PPMX1                    = 0.0               $Influence of inflation pressure on overturning moment
$-------------------------------------------------lateral_coefficients
[LATERAL_COEFFICIENTS]
PCY1                     = 1.45              $Shape factor Cfy for lateral forces
PDY1                     = 2.40              $Lateral friction Muy
PDY2                     = -0.25             $Variation of friction Muy with load
PDY3                     = 2.0               $Variation of friction Muy with squared camber
PEY1                     = -0.10             $Lateral curvature Efy at Fznom
PEY2                     = -0.20            $Variation of curvature Efy with load
PEY3                     = 0.02              $Zero order camber dependency of curvature Efy
PEY4                     = -0.50             $Variation of curvature Efy with camber
PEY5                     = 0.0               $Variation of curvature Efy with camber squared
PKY1                     = -45.0             $Maximum value of stiffness Kfy./Fznom
PKY2                     = 1.80              $Load at which Kfy reaches maximum value
PKY3                     = 0.25              $Variation of Kfy./Fznom with camber
PKY4                     = 2.0               $Curvature of stiffness Kfy
PKY5                     = 0.0               $Peak stiffness variation with camber squared
PKY6                     = -1.0              $Fy camber stiffness factor
PKY7                     = -0.20             $Vertical load dependency of camber stiffness
PHY1                     = 0.0006            $Horizontal shift Shy at Fznom
PHY2                     = 0.0002            $Variation of shift Shy with load
PVY1                     = 0.010            $Vertical shift in Svy./Fz at Fznom
PVY2                     = 0.010             $Variation of shift Svy./Fz with load
PVY3                     = -1.20             $Variation of shift Svy./Fz with camber
PVY4                     = -0.20             $Variation of shift Svy./Fz with camber and load
PPY1                     = 0.30              $influence of inflation pressure on cornering stiffness
PPY2                     = 0.50              $influence of inflation pressure on dependency of nominal tyre load on cornering stiffness
PPY3                     = -0.05             $linear influence of inflation pressure on lateral peak friction
PPY4                     = -0.40             $quadratic influence of inflation pressure on lateral peak friction
PPY5                     = 0.0               $Influence of inflation pressure on camber stiffness
RBY1                     = 10.0              $Slope factor for combined Fy reduction
RBY2                     = 8.0               $Variation of slope Fy reduction with alpha
RBY3                     = 0.002             $Shift term for alpha in slope Fy reduction
RBY4                     = 0.0               $Influence of camber on stiffness of Fy combined
RCY1                     = 1.05              $Shape factor for combined Fy reduction
REY1                     = 0.0               $Curvature factor of combined Fy
REY2                     = 0.0               $Curvature factor of combined Fy with load
RHY1                     = 0.0               $Shift factor for combined Fy reduction
RHY2                     = 0.0               $Shift factor for combined Fy reduction with load
RVY1                     = 0.0               $Kappa induced side force Svyk/Muy*Fz at Fznom
RVY2                     = 0.0               $Variation of Svyk/Muy*Fz with load
RVY3                     = 0.0               $Variation of Svyk/Muy*Fz with camber
RVY4                     = 0.0               $Variation of Svyk/Muy*Fz with alpha
RVY5                     = 1.9               $Variation of Svyk/Muy*Fz with kappa
RVY6                     = 10.0              $Variation of Svyk/Muy*Fz with atan(kappa)
$--------------------------------------------------rolling_coefficients
[ROLLING_COEFFICIENTS]
QSY1                     = 0.012             $Rolling resistance torque coefficient
QSY2                     = 0.0               $Rolling resistance torque depending on Fx
QSY3                     = 0.0005            $Rolling resistance torque depending on speed
QSY4                     = 0.0               $Rolling resistance torque depending on speed ^4
QSY5                     = 0.0               $Rolling resistance torque depending on camber squared
QSY6                     = 0.0               $Rolling resistance torque depending on load and camber squared
QSY7                     = 0.85              $Rolling resistance torque coefficient load dependency
QSY8                     = -0.40             $Rolling resistance torque coefficient pressure dependency
$-------------------------------------------------aligning_coefficients
[ALIGNING_COEFFICIENTS]
QBZ1                     = 10.0              $Trail slope factor for trail Bpt at Fznom
QBZ2                     = -1.0              $Variation of slope Bpt with load
QBZ3                     = 0.0               $Variation of slope Bpt with load squared
QBZ4                     = 0.0               $Variation of slope Bpt with camber
QBZ5                     = -0.1              $Variation of slope Bpt with absolute camber
QBZ9                     = 0.0               $Factor for scaling factors of slope factor Br of Mzr
QBZ10                    = 0.6               $Factor for dimensionless cornering stiffness of Br of Mzr
QCZ1                     = 1.20              $Shape factor Cpt for pneumatic trail
QDZ1                     = 0.070             $Peak trail Dpt = Dpt*(Fz/Fznom*R0)
QDZ2                     = -0.020            $Variation of peak Dpt with load
QDZ3                     = 0.50              $Variation of peak Dpt with camber
QDZ4                     = 0.0               $Variation of peak Dpt with camber squared
QDZ6                     = 0.002             $Peak residual torque Dmr = Dmr/(Fz*R0)
QDZ7                     = -0.001            $Variation of peak factor Dmr with load
QDZ8                     = -0.10             $Variation of peak factor Dmr with camber
QDZ9                     = 0.0               $Variation of peak factor Dmr with camber and load
QDZ10                    = 0.0               $Variation of peak factor Dmr with camber squared
QDZ11                    = 0.0               $Variation of Dmr with camber squared and load
QEZ1                     = -1.50             $Trail curvature Ept at Fznom
QEZ2                     = 0.50              $Variation of curvature Ept with load
QEZ3                     = 0.0               $Variation of curvature Ept with load squared
QEZ4                     = 0.20              $Variation of curvature Ept with sign of Alpha-t
QEZ5                     = 0.0               $Variation of Ept with camber and sign Alpha-t
QHZ1                     = 0.001             $Trail horizontal shift Sht at Fznom
QHZ2                     = 0.0005            $Variation of shift Sht with load
QHZ3                     = 0.0               $Variation of shift Sht with camber
QHZ4                     = 0.0               $Variation of shift Sht with camber and load
PPZ1                     = 0.30              $effect of inflation pressure on length of pneumatic trail
PPZ2                     = 0.0               $Influence of inflation pressure on residual aligning torque
SSZ1                     = 0.010             $Nominal value of s/R0: effect of Fx on Mz
SSZ2                     = 0.0               $Variation of distance s/R0 with Fy/Fznom
SSZ3                     = 0.0               $Variation of distance s/R0 with camber
SSZ4                     = 0.0               $Variation of distance s/R0 with load and camber
$-------------------------------------------------turnslip_coefficients
[TURNSLIP_COEFFICIENTS]
PDXP1                    = 0.4               $Peak Fx reduction due to spin parameter
PDXP2                    = 0                 $Peak Fx reduction due to spin with varying load parameter
PDXP3                    = 0                 $Peak Fx reduction due to spin with kappa parameter
PKYP1                    = 1                 $Cornering stiffness reduction due to spin
PDYP1                    = 0.4               $Peak Fy reduction due to spin parameter
PDYP2                    = 0                 $Peak Fy reduction due to spin with varying load parameter
PDYP3                    = 0                 $Peak Fy reduction due to spin with alpha parameter
PDYP4                    = 0                 $Peak Fy reduction due to square root of spin parameter
PHYP1                    = 1                 $Fy-alpha curve lateral shift limitation
PHYP2                    = 0.15              $Fy-alpha curve maximum lateral shift parameter
PHYP3                    = 0                 $Fy-alpha curve maximum lateral shift varying with load parameter
PHYP4                    = -4                $Fy-alpha curve maximum lateral shift parameter
PECP1                    = 0.5               $Camber w.r.t. spin reduction factor parameter in camber stiffness
PECP2                    = 0                 $Camber w.r.t. spin reduction factor varying with load parameter in camber stiffness
QDTP1                    = 10                $Pneumatic trail reduction factor due to turn slip parameter
QCRP1                    = 0.2               $Turning moment at constant turning and zero forward speed parameter
QCRP2                    = 0.1               $Turn slip moment (at alpha=90deg) parameter for increase with spin
QBRP1                    = 0.1               $Residual (spin) torque reduction factor parameter due to side slip
QDRP1                    = 1                 $Turn slip moment peak magnitude parameter
